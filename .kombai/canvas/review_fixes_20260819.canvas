quina\n                    </span>\n                </div>\n            </div>\n            <div class=\"row-full mt-[26px] pt-[26px]\" data-kid=\"1-5-1-5\" data-name=\"daily band item row\" style=\"border-top:1px solid var(--rule)\">\n                <div class=\"col-main\" data-kid=\"1-5-1-5-1\" data-name=\"item main content column\">\n                    <h3 class=\"t-display\" data-kid=\"1-5-1-5-1-1\" data-name=\"item title text\" style=\"font-size:clamp(34px,4.4vw,58px);color:var(--fg)\">\n                        Hario V60\n                    </h3>\n                </div>\n                <div class=\"col-mar leader mt-[18px]\" data-kid=\"1-5-1-5-2\" data-name=\"item marginal label\">\n                    <span aria-hidden=\"true\" class=\"ln\" data-kid=\"1-5-1-5-2-1\" data-name=\"item label line separator\">\n                    </span>\n                    <span class=\"lbl\" data-kid=\"1-5-1-5-2-2\" data-name=\"item label text\">\n                        Coado\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ═══════════ CHAPTER 01 — ESPRESSO ═══════════ -->\n    <section class=\"page page--ink-warm\" data-kid=\"1-6\" data-name=\"chapter espresso section\" id=\"cap-01\">\n        <div class=\"spread pt-[88px] pb-[96px]\" data-kid=\"1-6-1\" data-name=\"spread container\">\n            <div aria-hidden=\"true\" class=\"rule-col\" data-kid=\"1-6-1-1\" data-name=\"vertical rule column\">\n            </div>\n            <div class=\"col-main\" data-kid=\"1-6-1-2\" data-name=\"chapter title column\">\n                <h2 class=\"t-display\" data-kid=\"1-6-1-2-1\" data-name=\"chapter title heading\" style=\"font-size:var(--fs-display)\">\n                    <span class=\"underline-wrap\" data-kid=\"1-6-1-2-1-1\" data-name=\"title underline wrap\">\n                        Espresso\n                        <svg aria-hidden=\"true\" class=\"chapter-underline ink-draw\" data-dynamic=\"true\" data-kid=